[Unit]
Description=Restart Android's logd when it has deadlocked
# See /usr/lib/stone/logd-watchdog.py.
After=lxc-android-config.service
Wants=lxc-android-config.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/lib/stone/logd-watchdog.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
