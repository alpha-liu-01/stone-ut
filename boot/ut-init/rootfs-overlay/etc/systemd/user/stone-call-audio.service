[Unit]
Description=Route voice call audio (VoiceMMode1) while ofono has a call
# Started with PulseAudio, but not PartOf it: the watcher drives ALSA
# directly, and a PulseAudio restart mid-call must not run
# "call-audio.sh off" and cut the call audio.
After=pulseaudio.service

[Service]
Type=simple
ExecStart=/usr/lib/stone/call-audio-watch.sh
ExecStopPost=/usr/lib/stone/call-audio.sh off
Restart=on-failure
RestartSec=2

[Install]
WantedBy=pulseaudio.service
