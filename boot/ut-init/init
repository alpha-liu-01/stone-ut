#!/bin/sh
# First init for the sunstone Ubuntu Touch image.
# The userdata GPT partition is the Ubuntu root filesystem itself.
# jumpercable (/init in that rootfs) expects a second userdata partition,
# so this init enters /sbin/init directly.
# The Android 14 vendor ramdisk has no /proc, /sys or /dev, so this
# ramdisk carries its own mount points.

export PATH=/bin

mkdir -p /proc /sys /dev /tmp /config /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

log() {
    echo "stone-ut-init: $*" > /dev/kmsg
    echo "$*" >> /tmp/report.txt
}

# No console and no fbcon: a failure is only visible over USB.
fail() {
    log "FAIL: $*"
    mount -t configfs none /config 2>/dev/null
    G=/config/usb_gadget/g1
    mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.GS0"
    echo 0x0525 > "$G/idVendor"
    echo 0xa4a7 > "$G/idProduct"
    echo stone-ut > "$G/strings/0x409/manufacturer"
    echo boot-fail > "$G/strings/0x409/product"
    serial=stone
    for x in $(cat /proc/cmdline 2>/dev/null); do
        case "$x" in
        androidboot.serialno=*) serial=${x#*=} ;;
        esac
    done
    echo "$serial" > "$G/strings/0x409/serialnumber"
    echo fail > "$G/configs/c.1/strings/0x409/configuration"
    ln -s "$G/functions/acm.GS0" "$G/configs/c.1/" 2>/dev/null
    i=0
    while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ "$i" -lt 300 ]; do
        i=$((i + 1))
        sleep 0.1
    done
    ls /sys/class/udc 2>/dev/null | head -n 1 > "$G/UDC"
    while true; do
        {
            echo "===== STONE-UT-FAIL-BEGIN ====="
            cat /tmp/report.txt
            echo "===== DMESG ====="
            dmesg
            echo "===== STONE-UT-FAIL-END ====="
        } > /dev/ttyGS0 2>/dev/null
        sleep 3
    done
}

log "init start"

# Recovery (docs/roadmap-release.md item 1). stone has no recovery partition:
# like crDroid ("recovery as boot"), the bootloader boots this image for
# recovery too, and passes androidboot.force_normal_boot=1 only for a normal
# boot. For a recovery boot, unpack UBports' unified recovery ramdisk
# (/ramdisk-recovery.img, merged with boot/ut-recovery at build time) into a
# tmpfs and hand over to its Android init. A charger boot
# (androidboot.mode=charger) is not a recovery boot.
NORMAL_BOOT=
BOOT_MODE=
for x in $(cat /proc/cmdline); do
    case "$x" in
    androidboot.force_normal_boot=1) NORMAL_BOOT=y ;;
    androidboot.mode=*) BOOT_MODE=${x#*=} ;;
    esac
done
if [ -z "$NORMAL_BOOT" ] && [ "$BOOT_MODE" != charger ] && [ -f /ramdisk-recovery.img ]; then
    log "recovery boot (no androidboot.force_normal_boot=1)"
    mkdir -p /recovery
    mount -t tmpfs -o mode=0755 tmpfs /recovery || fail "could not mount the recovery tmpfs"
    (cd /recovery && gzip -dc /ramdisk-recovery.img | cpio -i -d -m) || fail "could not unpack the recovery ramdisk"
    [ -e /recovery/system/bin/init ] || fail "recovery ramdisk has no /system/bin/init"
    # The vendor ramdisk's /lib/modules are GKI modules that do not match this
    # kernel; leave them behind, so first-stage init skips module loading
    # instead of failing on them. Android's init mounts /proc, /sys and /dev.
    umount /dev/pts
    umount /dev
    umount /sys
    umount /proc
    exec switch_root /recovery /init
fi

part_dev() {
    name="$1"
    for ue in /sys/class/block/*/uevent; do
        if grep -q "^PARTNAME=${name}$" "$ue"; then
            devname=$(sed -n 's/^DEVNAME=//p' "$ue")
            echo "/dev/${devname}"
            return 0
        fi
    done
    return 1
}

i=0
USERDATA=""
while [ "$i" -lt 100 ]; do
    USERDATA=$(part_dev userdata) && break
    i=$((i + 1))
    sleep 0.1
done
[ -n "$USERDATA" ] || fail "userdata partition not found"
[ -b "$USERDATA" ] || fail "userdata node $USERDATA missing"
log "userdata is $USERDATA"

mount -t ext4 -o rw "$USERDATA" /newroot || fail "failed to mount $USERDATA"
[ -x /newroot/sbin/init ] || fail "missing /sbin/init"
[ -f /newroot/var/lib/lxc/android/android-rootfs.img ] || log "android-rootfs.img is absent"

dmesg > /newroot/stone-initramfs-dmesg.txt 2>/dev/null
cp /tmp/report.txt /newroot/stone-initramfs-report.txt 2>/dev/null
# One line per boot, kept across boots (docs/roadmap-release.md item 2): what
# the bootloader asked for (androidboot.mode, e.g. charger) and why the PMIC
# powered on (key press, charger insertion, reset).
PON=$(dmesg | sed -n 's/.*PMIC@SID0 Power-on reason: //p' | head -n 1)
BL=/newroot/stone-boot-modes.log
{
    [ -f "$BL" ] && tail -n 49 "$BL"
    echo "uptime=$(cut -d' ' -f1 /proc/uptime) mode=${BOOT_MODE:-none} force_normal_boot=${NORMAL_BOOT:-n} pon=${PON:-unknown}"
} > "$BL.new" && mv "$BL.new" "$BL"
log "boot mode ${BOOT_MODE:-none}, power-on reason: ${PON:-unknown}"

# Device files for the rootfs (Halium overlay and the like), refreshed on every
# boot from boot/ut-init/rootfs-overlay. The Ubuntu Touch image ships no
# /usr/share/halium-overlay of its own.
rm -rf /newroot/usr/share/halium-overlay
# The copy below only adds and overwrites. Files that used to be in the
# overlay and were dropped from it stay on the rootfs unless listed here.
for f in \
    etc/systemd/system/ofono.service.d/zz-stone-debug.conf \
    etc/systemd/user/lomiri-full-greeter.service.d/stone-core.conf \
    etc/systemd/system/usb-moded.service.d/zz-stone-test-no-rescue.conf \
    etc/systemd/system/usb-moded.service.d/zz-stone-debug.conf \
    etc/systemd/system/stone-boot-trace.service \
    etc/systemd/system/basic.target.wants/stone-boot-trace.service \
    etc/systemd/system/charger.target.wants/stone-boot-trace.service \
    usr/local/sbin/stone-boot-trace.sh \
    usr/local/lib/stone-test/usb-mtp-reconnect.py \
    etc/systemd/user/stone-usb-mtp-reconnect.service.d/zz-stone-test.conf \
    usr/local/lib/stone-test/bt-autoconnect.py \
    etc/systemd/system/stone-bt-autoconnect.service.d/zz-stone-test.conf \
    etc/systemd/system/multi-user.target.wants/stone-usb-mtp-reconnect.service \
    etc/systemd/system/stone-usb-mtp-reconnect.service \
    usr/lib/stone/usb-mtp-reconnect.sh \
    etc/systemd/system/basic.target.wants/stone-usb-boot-trace.service \
    etc/systemd/system/stone-usb-boot-trace.service \
    usr/local/sbin/stone-usb-boot-trace.sh \
    etc/systemd/system/multi-user.target.wants/stone-usb-typec-kick.service \
    etc/systemd/system/stone-usb-typec-kick.service \
    usr/lib/stone/usb-typec-kick.sh \
    usr/lib/stone/call-audio-watch.sh \
    usr/lib/stone/speaker-route.sh \
    etc/systemd/user/media-hub.service.d/zz-stone-unconfined.conf \
    usr/lib/stone/media-hub-server \
    ; do
    rm -f "/newroot/$f"
done
cp -R /stone-rootfs/. /newroot/ || log "could not install rootfs overlay"
# update-machine-info-from-deviceinfo only sets the pretty hostname when it
# is empty. The first boot ran before devices/stone.yaml existed and stored
# libdeviceinfo's fallback, which Bluetooth then advertises. Drop only the
# fallback names, so a name the user picked is kept.
MI=/newroot/etc/writable/machine-info
if [ -f "$MI" ] && grep -q '^PRETTY_HOSTNAME="Generic \(Halium \)\{0,1\}device"$' "$MI"; then
    sed -i '/^PRETTY_HOSTNAME="Generic \(Halium \)\{0,1\}device"$/d' "$MI"
    log "cleared generic pretty hostname"
fi
# Passwordless sudo exists only while booted from the trace image.
if [ -f /stone-sudoers ]; then
    cp /stone-sudoers /newroot/etc/sudoers.d/stone-trace
    chmod 440 /newroot/etc/sudoers.d/stone-trace
else
    rm -f /newroot/etc/sudoers.d/stone-trace
fi

NEXT_INIT=/sbin/init
if [ -f /stone-init-wrapper ]; then
    rm -rf /newroot/stone-logs/live
    mkdir -p /newroot/stone
    cp /bin/busybox /newroot/stone/busybox
    cp /stone-init-wrapper /newroot/stone/init-wrapper
    cp /reboot-bootloader /newroot/stone/reboot-bootloader
    chmod 755 /newroot/stone/busybox /newroot/stone/init-wrapper \
        /newroot/stone/reboot-bootloader
    NEXT_INIT=/stone/init-wrapper
fi

mount --move /proc /newroot/proc || fail "could not move /proc"
mount --move /sys /newroot/sys || fail "could not move /sys"
mount --move /dev /newroot/dev || fail "could not move /dev"

# vendor and odm live in super. Halium's mount-android-partitions finds
# them as /dev/mapper/<name>_b, which nothing else creates before udev.
mkdir -p /newroot/stone
cp /stone-dynparts.py /newroot/stone/dynparts.py
chroot /newroot /usr/bin/python3 /stone/dynparts.py \
    > /newroot/stone-dynparts.txt 2>&1
cp /stone-vendor-fixups.py /newroot/stone/vendor-fixups.py
chroot /newroot /usr/bin/python3 /stone/vendor-fixups.py \
    > /newroot/stone-vendor-fixups.txt 2>&1

# Wall clock (docs/roadmap-release.md item 14). The Qualcomm RTC cannot be set
# and counts from 1970; UBports' timekeeper keeps the offset to real time in
# /data/time/timekeep (= /var/lib/android-data/time/timekeep), stored at
# shutdown, but only restores it at about 12 s. Until then journald stamps
# everything with 1970, and its vacuuming, which orders files from different
# boots by their first timestamp, then deletes the start of each boot first.
# Set RTC + offset now, before systemd starts.
RTC=$(cat /newroot/sys/class/rtc/rtc0/since_epoch 2>/dev/null)
OFF=$(cat /newroot/var/lib/android-data/time/timekeep 2>/dev/null)
case "$RTC:$OFF" in
[0-9]*:[0-9]*)
    case "$RTC$OFF" in
    *[!0-9]*) log "clock not set: unexpected RTC '$RTC' or offset '$OFF'" ;;
    *)
        T=$((RTC + OFF))
        # Only a plausible result (after 2020-01-01).
        if [ "$T" -gt 1577836800 ] && chroot /newroot /usr/bin/python3 -I -c \
            'import sys, time; time.clock_settime(time.CLOCK_REALTIME, float(sys.argv[1]))' "$T"; then
            log "clock set to $T (RTC $RTC + timekeep offset $OFF)"
        else
            log "clock not set (RTC $RTC + offset $OFF)"
        fi
        ;;
    esac
    ;;
*) log "clock not set: no RTC or no timekeep offset" ;;
esac
sync

log "switch_root to $NEXT_INIT"
exec switch_root /newroot "$NEXT_INIT"
