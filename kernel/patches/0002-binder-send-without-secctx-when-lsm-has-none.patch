From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alpha-liu-01 <116528196+alpha-liu-01@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:09:10 -0500
Subject: [PATCH 02/10] binder: send without a security context when the LSM
 has none

The vendor servicemanager sets FLAT_BINDER_FLAG_TXN_SECURITY_CTX. On
this 5.4 kernel with only AppArmor (Halium runs without SELinux),
security_secid_to_secctx() returns -EINVAL for secid 0 and binder fails
every vndbinder transaction (29201/-22), so no vendor HAL can register.

When the LSM returns -EINVAL or -EOPNOTSUPP, send the transaction without
a security context. The receiver gets no SID and falls back to
getpidcon(), as it does on kernels without the feature.
---
 drivers/android/binder.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/android/binder.c b/drivers/android/binder.c
index ec18ba16d..48900053c 100644
--- a/drivers/android/binder.c
+++ b/drivers/android/binder.c
@@ -3295,7 +3295,6 @@ static void binder_transaction(struct binder_proc *proc,
 
 	if (target_node && target_node->txn_security_ctx) {
 		u32 secid;
-		size_t added_size;
 		int max_retries = 100;
 
 		security_cred_getsecid(binder_get_cred(proc), &secid);
@@ -3318,13 +3317,24 @@ static void binder_transaction(struct binder_proc *proc,
 				goto retry_alloc;
 			}
 		}
-		if (ret) {
+		if (ret == -EINVAL || ret == -EOPNOTSUPP) {
+			/*
+			 * No LSM has a context for this secid (selinux=0 with
+			 * AppArmor). Send the transaction without one; the
+			 * receiver sees no SID and falls back to getpidcon().
+			 */
+			secctx = NULL;
+			secctx_sz = 0;
+		} else if (ret) {
 			return_error = BR_FAILED_REPLY;
 			return_error_param = ret;
 			return_error_line = __LINE__;
 			goto err_get_secctx_failed;
 		}
-		added_size = ALIGN(secctx_sz, sizeof(u64));
+	}
+	if (secctx) {
+		size_t added_size = ALIGN(secctx_sz, sizeof(u64));
+
 		extra_buffers_size += added_size;
 		if (extra_buffers_size < added_size) {
 			/* integer overflow of extra_buffers_size */
