CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_BT_HCIVHCI=m
# Android f_mtp for usb-moded/mtp-server (kernel/patches/0007).
CONFIG_USB_CONFIGFS_F_MTP=y
